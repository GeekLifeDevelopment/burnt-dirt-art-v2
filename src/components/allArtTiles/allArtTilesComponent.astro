  function openPin(pin: Element) {
    const title = pin.getAttribute("data-title") || "";
    const storeUrl = pin.getAttribute("data-store-url") || "";
    const isSold = pin.getAttribute("data-is-sold") === "true";

    const imgElement = pin.querySelector(".homeFeaturedCardMedia img") as HTMLImageElement;
    if (imgElement) {
      (modalImage as HTMLImageElement).src = imgElement.src;
      (modalImage as HTMLImageElement).alt = title;
    }
    if (modalTitle) modalTitle.textContent = title;

    if (soldMarker) {
      soldMarker.style.display = isSold ? "inline-block" : "none";
    }

    if (modalActions) {
      modalActions.innerHTML = "";
      if (!isSold && storeUrl) {
        const storeButton = document.createElement("a");
        storeButton.href = storeUrl;
        storeButton.className = "storeButton";
        storeButton.textContent = "View Store Listing";
        modalActions.appendChild(storeButton);
      }
    }

    activeModalPin = pin;
    modal?.classList.add("active");
    document.body.classList.add("modal-open");
  }

  function getVisiblePins(): Element[] {
    return Array.from(artPins).filter((pin) => {
      return (pin as HTMLElement).style.display !== "none";
    });
  }

  function navigateModal(direction: 1 | -1) {
    if (!modal?.classList.contains("active")) return;

    const visiblePins = getVisiblePins();
    if (visiblePins.length === 0) return;

    const currentIndex = activeModalPin ? visiblePins.indexOf(activeModalPin) : -1;
    const startIndex = currentIndex >= 0 ? currentIndex : 0;
    const nextIndex = (startIndex + direction + visiblePins.length) % visiblePins.length;

    openPin(visiblePins[nextIndex]);
  }

  function closeModal() {
    modal?.classList.remove("active");
    document.body.classList.remove("modal-open");
    activeModalPin = null;
  }

  artPins.forEach((pin) => {
    const card = pin.querySelector(".galleryCard");
    card?.addEventListener("click", () => openPin(pin));
    card?.addEventListener("keydown", (e) => {
      const key = (e as KeyboardEvent).key;
      if (key === "Enter" || key === " ") {
        e.preventDefault();
        openPin(pin);
      }
    });
  });

  closeBtn?.addEventListener("click", closeModal);

  modal?.addEventListener("click", (e) => {
    if (e.target === modal) {
      closeModal();
    }
  });

  window.addEventListener("keydown", (e) => {
    const key = (e as KeyboardEvent).key;
    if (key === "Escape" && modal?.classList.contains("active")) {
      closeModal();
      return;
    }

    if (key === "ArrowRight" && modal?.classList.contains("active")) {
      e.preventDefault();
      navigateModal(1);
      return;
    }

    if (key === "ArrowLeft" && modal?.classList.contains("active")) {
      e.preventDefault();
      navigateModal(-1);
    }
  });
</script>