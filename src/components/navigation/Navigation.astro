---
import './navigation.styles.css';
import headerLogo from '../../assets/bda-header-logo.png';

const { pathname } = Astro.url;
const isHomePage = pathname === '/' || pathname === '';
const isAboutPage = pathname === '/about';
const isGalleryPage = pathname === '/gallery';
const isContactPage = pathname === '/contact';
const isShopOriginalsPage = pathname === '/shop' || (pathname.startsWith('/shop/') && !pathname.startsWith('/shop/prints'));
const isShopPrintsPage = pathname === '/shop/prints' || pathname.startsWith('/shop/prints/');
const isCartPage = pathname === '/cart';
---

<nav class={`navContainer ${isHomePage ? 'navContainer--home' : 'navContainer--compact'}`}>
    <div class="navContent ds-container">
        <a href="/" class="brandMark" aria-label="Burnt Dirt Art home">
            <img
                class="brandMarkImage"
                src={headerLogo.src}
                width={headerLogo.width}
                height={headerLogo.height}
                alt="Burnt Dirt Art"
            />
        </a>

        <button
            class="hamburger"
            id="hamburger"
            aria-expanded="false"
            aria-controls="navList"
            aria-label="Toggle navigation"
        >
            <i class="fas fa-bars" aria-hidden="true"></i>
        </button>

        <ul class="navList" id="navList">
            <li>
                <a href="/" class={`navLink ${isHomePage ? 'is-active' : ''}`} aria-current={isHomePage ? 'page' : undefined}>Home</a>
            </li>
            <li>
                <a href="/about" class={`navLink ${isAboutPage ? 'is-active' : ''}`} aria-current={isAboutPage ? 'page' : undefined}>About</a>
            </li>
            <li>
                <a href="/gallery" class={`navLink ${isGalleryPage ? 'is-active' : ''}`} aria-current={isGalleryPage ? 'page' : undefined}>Gallery</a>
            </li>
            <li>
                <a href="/shop" class={`navLink ${isShopOriginalsPage ? 'is-active' : ''}`} aria-current={isShopOriginalsPage ? 'page' : undefined}>Shop Originals</a>
            </li>
            <li>
                <a href="/shop/prints" class={`navLink ${isShopPrintsPage ? 'is-active' : ''}`} aria-current={isShopPrintsPage ? 'page' : undefined}>Shop Prints</a>
            </li>
            <li>
                <a href="/cart" class={`navLink navLink--cart ${isCartPage ? 'is-active' : ''}`} aria-current={isCartPage ? 'page' : undefined}>
                    <i class="fas fa-shopping-bag" aria-hidden="true"></i>
                    <span>Cart</span>
                    <span class="cartCount" id="navCartCount" aria-live="polite">0</span>
                </a>
            </li>
            <li>
                <a href="/contact" class={`navLink ${isContactPage ? 'is-active' : ''}`} aria-current={isContactPage ? 'page' : undefined}>Contact</a>
            </li>
        </ul>
    </div>

</nav>

<script>
    import { CART_EVENTS, getCartCount } from '../../scripts/cart';

    const hamburger = document.getElementById('hamburger');
    const navList = document.getElementById('navList');
    const navLinks = navList?.querySelectorAll('a');
    const navCartCount = document.getElementById('navCartCount');

    const refreshCartCount = () => {
        const count = getCartCount();
        if (navCartCount) {
            navCartCount.textContent = String(count);
            navCartCount.classList.toggle('is-empty', count === 0);
        }
    };

    refreshCartCount();

    const closeMenu = () => {
        navList?.classList.remove('active');
        hamburger?.setAttribute('aria-expanded', 'false');
    };

    hamburger?.addEventListener('click', () => {
        navList?.classList.toggle('active');
        const isExpanded = navList?.classList.contains('active') || false;
        hamburger.setAttribute('aria-expanded', String(isExpanded));
    });

    navLinks?.forEach((link) => {
        link.addEventListener('click', closeMenu);
    });

    window.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
            closeMenu();
            hamburger?.focus();
        }
    });

    window.addEventListener('resize', () => {
        if (window.innerWidth > 900) {
            closeMenu();
        }
    });

    window.addEventListener(CART_EVENTS.UPDATED, refreshCartCount);
    window.addEventListener('storage', (event) => {
        if (event.key === 'bda_cart_v1') {
            refreshCartCount();
        }
    });
</script>