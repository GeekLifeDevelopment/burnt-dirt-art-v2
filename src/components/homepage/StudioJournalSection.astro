---
---

<section class="homeStudioJournalSection" aria-labelledby="home-connect-title">
	<div class="ds-container homeStudioJournalInner">
		<div class="homeStudioJournalCopy ds-stack ds-stack--sm">
			<p class="ds-eyebrow">From the Studio</p>
			<h2 id="home-connect-title">Join the Studio Journal</h2>
			<p>
				Subscribers receive updates about new artwork, studio stories, upcoming shows, and commission availability.
			</p>
			<form class="homeConnectForm" action="/contact" method="get">
				<label class="sr-only" for="home-newsletter-email">Email address</label>
				<input id="home-newsletter-email" name="email" type="email" placeholder="Your email address" required />
				<button type="submit">Join the Studio Journal</button>
			</form>
		</div>

		<aside class="homeStudioBulletin" aria-labelledby="home-studio-notice-title">
			<p class="homeStudioBulletinEyebrow">What&rsquo;s Happening</p>
			<h3 id="home-studio-notice-title">Studio bulletin</h3>
			<ul class="homeStudioBulletinList" aria-label="Studio updates">
				<li>
					<span class="homeStudioBulletinIcon" aria-hidden="true"><i class="far fa-calendar-alt"></i></span>
					<div>
						<strong>Upcoming Shows</strong>
						<p>See where Burnt Dirt Art will be available in person.</p>
					</div>
				</li>
				<li>
					<span class="homeStudioBulletinIcon" aria-hidden="true"><i class="far fa-image"></i></span>
					<div>
						<strong>New Originals</strong>
						<p>Get first notice when fresh one-of-a-kind pieces are released.</p>
					</div>
				</li>
				<li>
					<span class="homeStudioBulletinIcon" aria-hidden="true"><i class="far fa-pen-to-square"></i></span>
					<div>
						<strong>Commission Availability</strong>
						<p>Learn when custom work and special projects are open.</p>
					</div>
				</li>
				<li>
					<span class="homeStudioBulletinIcon" aria-hidden="true"><i class="fas fa-store"></i></span>
					<div>
						<strong>Shop Updates</strong>
						<p>Stay in the loop on new listings, restocks, and print updates.</p>
					</div>
				</li>
			</ul>
		</aside>
	</div>
</section>