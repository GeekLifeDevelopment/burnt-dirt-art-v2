---
import Layout from '../layouts/Layout.astro';
import '../styles/homepage-redesign.css';
import * as contentful from 'contentful';
import { artistName } from '../config/seo';

// Get environment variables with fallbacks for Netlify builds
const space = import.meta.env.CONTENTFUL_SPACE_ID || process.env.CONTENTFUL_SPACE_ID;
const accessToken = import.meta.env.CONTENTFUL_ACCESS_TOKEN || process.env.CONTENTFUL_ACCESS_TOKEN;

function toPrice(value: any): string | undefined {
    if (value === undefined || value === null) return undefined;
    const normalized = String(value).trim();
    if (!normalized) return undefined;
    return normalized.startsWith('$') ? normalized : `$${normalized}`;
}

// Fetch shop items from Contentful
let shopItems: any[] = [];
let categories: string[] = [];

function normalizeToList(value: any): string[] {
    if (!value) return [];

    if (Array.isArray(value)) {
        return value
            .map((entry) => (typeof entry === 'string' ? entry : String(entry ?? '')))
            .map((entry) => entry.trim().toLowerCase())
            .filter(Boolean);
    }

    if (typeof value === 'string') {
        return value
            .split(/[;,]/)
            .map((entry) => entry.trim().toLowerCase())
            .filter(Boolean);
    }

    return [String(value).trim().toLowerCase()].filter(Boolean);
}

function isChecked(value: any): boolean {
    if (typeof value === 'boolean') return value;
    if (typeof value === 'number') return value === 1;
    if (typeof value === 'string') {
        const normalized = value.trim().toLowerCase();
        return ['true', '1', 'yes', 'y', 'checked'].includes(normalized);
    }
    return false;
}

function isShopSelected(item: any): boolean {
    if (isChecked(item.fields.shop) || isChecked(item.fields.store)) {
        return true;
    }

    const candidates = [
        item.fields.page,
        item.fields.pages,
        item.fields.pageSection,
        item.fields.pageSections,
        item.fields.sections
    ];

    const values = candidates.flatMap((candidate) => normalizeToList(candidate));
    return values.includes('shop') || values.includes('store');
}

function parseSaleState(item: any): { isSold: boolean; isForSale: boolean } {
    if (typeof item.fields.forSale === 'boolean') {
        return { isSold: !item.fields.forSale, isForSale: item.fields.forSale };
    }

    if (item.fields.sold === true) {
        return { isSold: true, isForSale: false };
    }

    const saleValue = String(item.fields.sale ?? item.fields.status ?? '').trim().toLowerCase();

    if (saleValue.includes('sold')) {
        return { isSold: true, isForSale: false };
    }

    if (item.fields.forSale === true || item.fields.sale === true || saleValue.includes('for sale') || saleValue === 'sale') {
        return { isSold: false, isForSale: true };
    }

    return { isSold: false, isForSale: false };
}

if (!space || !accessToken) {
    console.warn(
        'Missing Contentful credentials. Shop page will render without product data. ' +
        'Set CONTENTFUL_SPACE_ID and CONTENTFUL_ACCESS_TOKEN in Netlify environment variables.'
    );
} else {
    const client = contentful.createClient({
        space,
        accessToken
  });

    try {
        const entries = await client.getEntries({ 
            content_type: 'artProduct'
        });
        shopItems = entries.items.filter((item: any) => {
            if (!isShopSelected(item)) return false;
            const { isSold } = parseSaleState(item);
            return !isSold;
        });
    
        // Extract unique categories with normalization
        const categorySet = new Set<string>();
        shopItems.forEach(item => {
            if (item.fields.category) {
                // Convert to string, trim whitespace and normalize the category
                const normalizedCategory = String(item.fields.category).trim();
                if (normalizedCategory) {
                    categorySet.add(normalizedCategory);
                }
      }
        });
        categories = Array.from(categorySet).sort();
    } catch (error) {
        console.error('Error fetching Contentful data:', error);
    }
}

const siteUrl = Astro.site?.toString() || 'https://burntdirtart.com';

const itemListElements = shopItems
    .map((item, index) => {
        if (!item.fields.inventoryCode) return null;

        const imageUrl = item.fields.images?.[0]?.fields?.file?.url
            ? `https:${item.fields.images[0].fields.file.url}`
            : undefined;

        return {
            '@type': 'ListItem',
            position: index + 1,
            item: {
                '@type': 'VisualArtwork',
                name: item.fields.title || item.fields.inventoryCode || 'Artwork Listing',
                url: new URL(`/shop/${item.fields.inventoryCode}`, siteUrl).toString(),
                image: imageUrl
            }
        };
    })
    .filter(Boolean);

const pageSchema = itemListElements.length
    ? {
        '@context': 'https://schema.org',
        '@type': 'ItemList',
        name: 'Burnt Dirt Art Original Artwork',
        url: new URL('/shop', siteUrl).toString(),
        numberOfItems: itemListElements.length,
        itemListElement: itemListElements,
        author: {
            '@type': 'Person',
            name: artistName
        }
    }
    : undefined;

const pinboardStyles = [
    { rotate: -2, lift: 0, attach: 'pin' },
    { rotate: 1, lift: 16, attach: 'tape' },
    { rotate: -1, lift: -8, attach: 'corner' },
    { rotate: 2, lift: 10, attach: 'clip' },
    { rotate: -1, lift: -4, attach: 'tape' }
];
---

<Layout
    pageTitle="Shop Original Art"
    description="Browse available original Burnt Dirt Art pieces, complete with full details, pricing, and purchase information."
    canonicalPath="/shop"
    pageSchema={pageSchema}
>
    <section class="galleryIntroSection" aria-labelledby="shop-title">
        <div class="ds-container">
            <div class="homeFeaturedHeader">
                <p class="ds-eyebrow">Shop</p>
                <h1 id="shop-title">Shop Original Artwork</h1>
                <p class="homeFeaturedLead">
                    Browse current available work below. Purchases are completed right here on the Burnt Dirt Art store.
                </p>
            </div>
        </div>
    </section>

    <section class="galleryBoardSection">
        <div class="ds-container">
            {shopItems.length > 0 ? (
                <>
                    {categories.length > 0 && (
                        <div class="shopFilterBar">
                            <label for="categoryFilter">Filter by Category:</label>
                            <select id="categoryFilter">
                                <option value="all">All Categories</option>
                                {categories.map(category => (
                                    <option value={category}>{category}</option>
                                ))}
                            </select>
                        </div>
                    )}

                    <ul class="homeFeaturedBoard" aria-label="Shop artwork">
                        {shopItems.map((item, index) => {
                            const meta = pinboardStyles[index % pinboardStyles.length];
                            const pinStyle = `--card-rotate: ${meta.rotate}deg; --card-lift: ${meta.lift}px; z-index: ${10 + index};`;
                            const price = toPrice(item.fields.price);
                            const category = item.fields.category ? String(item.fields.category).trim() : 'uncategorized';

                            return (
                                <li class="homeFeaturedPin" style={pinStyle} data-category={category}>
                                    <a class="homeFeaturedCard" href={`/shop/${item.fields.inventoryCode}`}>
                                        <span class={`homeFeaturedAttach homeFeaturedAttach--${meta.attach}`} aria-hidden="true"></span>
                                        {item.fields.images && item.fields.images.length > 0 && (
                                            <span class="homeFeaturedCardMedia">
                                                <img
                                                    src={`https:${item.fields.images[0].fields.file.url}`}
                                                    alt={item.fields.title || item.fields.inventoryCode}
                                                    width={item.fields.images[0].fields.file.details?.image?.width}
                                                    height={item.fields.images[0].fields.file.details?.image?.height}
                                                    loading="lazy"
                                                    decoding="async"
                                                />
                                            </span>
                                        )}
                                        <span class="homeFeaturedCardBody">
                                            <span class="homeFeaturedCardTitle">{item.fields.title || item.fields.inventoryCode}</span>
                                            {price && <span class="homeFeaturedCardPrice">{price}</span>}
                                        </span>
                                    </a>
                                </li>
                            );
                        })}
                    </ul>
                </>
            ) : (
                <p class="shopEmptyMessage">
                    No original pieces are available right now. Please check back soon, or
                    <a href="/contact">reach out</a> about a custom commission.
                </p>
            )}
        </div>
    </section>
</Layout>

<script>
    const categoryFilter = document.getElementById('categoryFilter') as HTMLSelectElement;
    const shopPins = document.querySelectorAll<HTMLElement>('.homeFeaturedPin');

    categoryFilter?.addEventListener('change', () => {
        const selectedCategory = categoryFilter.value;

        shopPins.forEach((pin) => {
            const itemCategory = pin.getAttribute('data-category');

            pin.style.display = selectedCategory === 'all' || itemCategory === selectedCategory ? '' : 'none';
        });
    });
</script>

<style>
    .galleryIntroSection {
        background-color: var(--home-paper);
        padding: clamp(2.5rem, 5vw, 4rem) 0 0;
        display: flow-root;
    }

    .galleryBoardSection {
        background-color: var(--home-paper);
        padding-bottom: clamp(2rem, 5vw, 4rem);
    }

    .shopFilterBar {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin: 0 0 1.5rem;
        padding: 0;
        width: 100%;
        box-sizing: border-box;
    }

    .shopFilterBar label {
        font-family: var(--font-serif);
        font-weight: 600;
        color: var(--color-walnut);
    }

    .shopFilterBar select {
        padding: 0.5rem 1rem;
        border: 1px solid rgba(74, 55, 40, 0.3);
        border-radius: 4px;
        font-size: 1rem;
        background-color: #fff;
        color: var(--color-charcoal);
        cursor: pointer;
        max-width: 100%;
        min-width: 0;
    }

    .shopFilterBar select:focus {
        outline: none;
        border-color: var(--color-terracotta);
    }

    .shopEmptyMessage {
        max-width: 46rem;
        margin: 0 auto;
        text-align: center;
        line-height: 1.6;
    }

    @media (max-width: 768px) {
        .shopFilterBar {
            flex-wrap: wrap;
            align-items: stretch;
            gap: 0.5rem;
        }

        .shopFilterBar label {
            width: 100%;
        }

        .shopFilterBar select {
            width: 100%;
            font-size: 16px;
        }
    }
</style>
