---
import Layout from '../../layouts/Layout.astro';
import '../../styles/homepage-redesign.css';
import * as contentful from 'contentful';
import { artistName } from '../../config/seo';

const pinboardStyles = [
    { rotate: -2, lift: 0, attach: 'pin' },
    { rotate: 1, lift: 16, attach: 'tape' },
    { rotate: -1, lift: -8, attach: 'corner' },
    { rotate: 2, lift: 10, attach: 'clip' },
    { rotate: -1, lift: -4, attach: 'tape' }
];

const space = import.meta.env.CONTENTFUL_SPACE_ID || process.env.CONTENTFUL_SPACE_ID;
const accessToken = import.meta.env.CONTENTFUL_ACCESS_TOKEN || process.env.CONTENTFUL_ACCESS_TOKEN;

let printItems: any[] = [];

function extractText(richText: any): string {
    if (!richText || !richText.content) return '';

    let text = '';
    const traverse = (node: any) => {
        if (node.nodeType === 'text') {
            text += node.value;
        }
        if (node.content && Array.isArray(node.content)) {
            node.content.forEach((child: any) => {
                traverse(child);
                if (['paragraph', 'heading-1', 'heading-2', 'heading-3'].includes(child.nodeType)) {
                    text += '\n';
                }
            });
        }
    };

    traverse(richText);
    return text.trim();
}

function toText(value: any): string {
    if (!value) return '';
    if (typeof value === 'string') return value.trim();
    return extractText(value);
}

function normalizeToList(value: any): string[] {
    if (!value) return [];

    if (Array.isArray(value)) {
        return value
            .map((entry) => (typeof entry === 'string' ? entry : String(entry ?? '')))
            .map((entry) => entry.trim().toLowerCase())
            .filter(Boolean);
    }

    if (typeof value === 'string') {
        return value
            .split(/[;,]/)
            .map((entry) => entry.trim().toLowerCase())
            .filter(Boolean);
    }

    return [String(value).trim().toLowerCase()].filter(Boolean);
}

function hasPrintAvailableCategory(item: any): boolean {
    const categories = normalizeToList(item.fields.category);
    return categories.includes('print available');
}

function fieldValue(item: any, keys: string[]): any {
    for (const key of keys) {
        if (item.fields[key] !== undefined && item.fields[key] !== null) {
            return item.fields[key];
        }
    }
    return undefined;
}

function getPreferredImages(item: any): any[] {
    const printImages = fieldValue(item, ['printImages', 'PrintImages']);

    if (Array.isArray(printImages) && printImages.length > 0) {
        return printImages;
    }

    if (Array.isArray(item.fields.images) && item.fields.images.length > 0) {
        return item.fields.images;
    }

    return [];
}

if (!space || !accessToken) {
    console.warn(
        'Missing Contentful credentials. Prints page will render without product data. ' +
        'Set CONTENTFUL_SPACE_ID and CONTENTFUL_ACCESS_TOKEN in Netlify environment variables.'
    );
} else {
    const client = contentful.createClient({
        space,
        accessToken
    });

    try {
        const entries = await client.getEntries({
            content_type: 'artProduct'
        });

        printItems = entries.items.filter((item: any) => hasPrintAvailableCategory(item));
    } catch (error) {
        console.error('Error fetching print data from Contentful:', error);
    }
}

const siteUrl = Astro.site?.toString() || 'https://burntdirtart.com';

const itemListElements = printItems
    .map((item, index) => {
        if (!item.fields.inventoryCode) return null;

        const preferredImages = getPreferredImages(item);

        const imageUrl = preferredImages?.[0]?.fields?.file?.url
            ? `https:${preferredImages[0].fields.file.url}`
            : undefined;

        const printTitle = toText(fieldValue(item, ['printTitle', 'PrintTitle'])) || item.fields.title || item.fields.inventoryCode || 'Print Listing';

        return {
            '@type': 'ListItem',
            position: index + 1,
            item: {
                '@type': 'Product',
                name: printTitle,
                url: new URL(`/shop/prints/${item.fields.inventoryCode}`, siteUrl).toString(),
                image: imageUrl
            }
        };
    })
    .filter(Boolean);

const pageSchema = itemListElements.length
    ? {
        '@context': 'https://schema.org',
        '@type': 'ItemList',
        name: 'Burnt Dirt Art Prints',
        url: new URL('/shop/prints', siteUrl).toString(),
        numberOfItems: itemListElements.length,
        itemListElement: itemListElements,
        author: {
            '@type': 'Person',
            name: artistName
        }
    }
    : undefined;
---

<Layout
    pageTitle="Shop Prints"
    description="Browse print editions from Burnt Dirt Art and view full details in the shop."
    canonicalPath="/shop/prints"
    pageSchema={pageSchema}
>
    <section class="galleryIntroSection" aria-labelledby="prints-title">
        <div class="ds-container">
            <div class="homeFeaturedHeader">
                <p class="ds-eyebrow">Shop</p>
                <h1 id="prints-title">Shop Prints</h1>
                <p class="homeFeaturedLead">
                    Browse print editions currently available from Burnt Dirt Art. Select any piece for full details.
                </p>
            </div>
        </div>
    </section>

    <section class="galleryBoardSection">
        <div class="ds-container">
            {printItems.length > 0 ? (
                <ul class="homeFeaturedBoard printsBoard" aria-label="Available prints">
                    {printItems.map((item: any, index: number) => {
                        if (!item.fields.inventoryCode) return null;

                        const printTitle = toText(fieldValue(item, ['printTitle', 'PrintTitle'])) || item.fields.title || item.fields.inventoryCode;
                        const printPrice = fieldValue(item, ['printPrice', 'PrintPrice']) || item.fields.price;
                        const preferredImages = getPreferredImages(item);
                        const meta = pinboardStyles[index % pinboardStyles.length];
                        const pinStyle = `--card-rotate: ${meta.rotate}deg; --card-lift: ${meta.lift}px; z-index: ${10 + index};`;

                        return (
                            <li class="homeFeaturedPin" style={pinStyle}>
                                <a class="homeFeaturedCard" href={`/shop/prints/${item.fields.inventoryCode}`}>
                                    <span class={`homeFeaturedAttach homeFeaturedAttach--${meta.attach}`} aria-hidden="true"></span>
                                    {preferredImages.length > 0 && (
                                        <span class="homeFeaturedCardMedia">
                                            <img
                                                src={`https:${preferredImages[0].fields.file.url}`}
                                                alt={printTitle || 'Burnt Dirt Art print'}
                                                width={preferredImages[0].fields.file.details?.image?.width}
                                                height={preferredImages[0].fields.file.details?.image?.height}
                                                loading="lazy"
                                                decoding="async"
                                            />
                                        </span>
                                    )}
                                    <span class="homeFeaturedCardBody">
                                        <span class="homeFeaturedCardTitle">{printTitle || 'Untitled Print'}</span>
                                        {printPrice && <span class="homeFeaturedCardPrice">${printPrice}</span>}
                                    </span>
                                </a>
                            </li>
                        );
                    })}
                </ul>
            ) : (
                <p class="printsEmptyMessage">
                    No prints are available right now. Please check back soon or visit the <a href="/shop">original art shop</a>.
                </p>
            )}
        </div>
    </section>
</Layout>

<style>
    .galleryIntroSection {
        background-color: var(--home-paper);
        padding: clamp(2.5rem, 5vw, 4rem) 0 0;
        display: flow-root;
    }

    .galleryBoardSection {
        background-color: var(--home-paper);
        padding-bottom: clamp(2rem, 5vw, 4rem);
    }

    .printsBoard {
        margin-top: 0.4rem;
    }

    .printsEmptyMessage {
        max-width: 46rem;
        margin: 0 auto;
        text-align: center;
        line-height: 1.6;
    }

    @media (max-width: 768px) {
        .printsBoard {
            margin-top: 0;
        }
    }
</style>
