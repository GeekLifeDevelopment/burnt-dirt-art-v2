---
import Layout from '../../../layouts/Layout.astro';
import '../../../styles/homepage-redesign.css';
import * as contentful from 'contentful';
import { artistName } from '../../../config/seo';

export async function getStaticPaths() {
    const normalizeToList = (value: any): string[] => {
        if (!value) return [];

        if (Array.isArray(value)) {
            return value
                .map((entry) => (typeof entry === 'string' ? entry : String(entry ?? '')))
                .map((entry) => entry.trim().toLowerCase())
                .filter(Boolean);
        }

        if (typeof value === 'string') {
            return value
                .split(/[;,]/)
                .map((entry) => entry.trim().toLowerCase())
                .filter(Boolean);
        }

        return [String(value).trim().toLowerCase()].filter(Boolean);
    };

    const hasPrintAvailableCategory = (item: any): boolean => {
        const categories = normalizeToList(item.fields.category);
        return categories.includes('print available');
    };

    const space = import.meta.env.CONTENTFUL_SPACE_ID || process.env.CONTENTFUL_SPACE_ID;
    const accessToken = import.meta.env.CONTENTFUL_ACCESS_TOKEN || process.env.CONTENTFUL_ACCESS_TOKEN;

    if (!space || !accessToken) {
        console.warn(
            'Missing Contentful credentials. Returning no static print detail pages. ' +
            'Set CONTENTFUL_SPACE_ID and CONTENTFUL_ACCESS_TOKEN in Netlify environment variables.'
        );
        return [];
    }

    const client = contentful.createClient({
        space,
        accessToken
    });

    try {
        const entries = await client.getEntries({
            content_type: 'artProduct'
        });

        return entries.items
            .filter((item: any) => item.fields.inventoryCode && hasPrintAvailableCategory(item))
            .map((item: any) => ({
                params: { slug: item.fields.inventoryCode },
                props: { item }
            }));
    } catch (error) {
        console.error('Error fetching print products for static paths:', error);
        return [];
    }
}

function extractText(richText: any): string {
    if (!richText || !richText.content) return '';

    let text = '';
    const traverse = (node: any) => {
        if (node.nodeType === 'text') {
            text += node.value;
        }
        if (node.content && Array.isArray(node.content)) {
            node.content.forEach((child: any) => {
                traverse(child);
                if (['paragraph', 'heading-1', 'heading-2', 'heading-3'].includes(child.nodeType)) {
                    text += '\n';
                }
            });
        }
    };

    traverse(richText);
    return text.trim();
}

function toText(value: any): string {
    if (!value) return '';
    if (typeof value === 'string') return value.trim();
    return extractText(value);
}

function normalizeToList(value: any): string[] {
    if (!value) return [];

    if (Array.isArray(value)) {
        return value
            .map((entry) => (typeof entry === 'string' ? entry : String(entry ?? '')))
            .map((entry) => entry.trim().toLowerCase())
            .filter(Boolean);
    }

    if (typeof value === 'string') {
        return value
            .split(/[;,]/)
            .map((entry) => entry.trim().toLowerCase())
            .filter(Boolean);
    }

    return [String(value).trim().toLowerCase()].filter(Boolean);
}

function isChecked(value: any): boolean {
    if (typeof value === 'boolean') return value;
    if (typeof value === 'number') return value === 1;
    if (typeof value === 'string') {
        const normalized = value.trim().toLowerCase();
        return ['true', '1', 'yes', 'y', 'checked'].includes(normalized);
    }
    return false;
}

function isShopSelected(item: any): boolean {
    if (isChecked(item.fields.shop) || isChecked(item.fields.store)) {
        return true;
    }

    const candidates = [
        item.fields.page,
        item.fields.pages,
        item.fields.pageSection,
        item.fields.pageSections,
        item.fields.sections
    ];

    const values = candidates.flatMap((candidate) => normalizeToList(candidate));
    return values.includes('shop') || values.includes('store');
}

function parseSaleState(item: any): { isSold: boolean; isForSale: boolean } {
    if (typeof item.fields.forSale === 'boolean') {
        return { isSold: !item.fields.forSale, isForSale: item.fields.forSale };
    }

    if (item.fields.sold === true) {
        return { isSold: true, isForSale: false };
    }

    const saleValue = String(item.fields.sale ?? item.fields.status ?? '').trim().toLowerCase();

    if (saleValue.includes('sold')) {
        return { isSold: true, isForSale: false };
    }

    if (item.fields.forSale === true || item.fields.sale === true || saleValue.includes('for sale') || saleValue === 'sale') {
        return { isSold: false, isForSale: true };
    }

    return { isSold: false, isForSale: false };
}

function fieldValue(item: any, keys: string[]): any {
    for (const key of keys) {
        if (item.fields[key] !== undefined && item.fields[key] !== null) {
            return item.fields[key];
        }
    }
    return undefined;
}

function getPreferredImages(item: any): any[] {
    const printImages = fieldValue(item, ['printImages', 'PrintImages']);

    if (Array.isArray(printImages) && printImages.length > 0) {
        return printImages;
    }

    if (Array.isArray(item.fields.images) && item.fields.images.length > 0) {
        return item.fields.images;
    }

    return [];
}

const { item } = Astro.props;
const printTitle = toText(fieldValue(item, ['printTitle', 'PrintTitle'])) || item.fields.title || item.fields.inventoryCode;
const printDescription = toText(fieldValue(item, ['printDescription', 'PrintDescription'])) || toText(item.fields.description);
const printPrice = fieldValue(item, ['printPrice', 'PrintPrice']) || item.fields.price;
const { isSold: isOriginalSold } = parseSaleState(item);
const hasOriginalAvailable = Boolean(item.fields.inventoryCode) && isShopSelected(item) && !isOriginalSold;
const preferredImages = getPreferredImages(item);

const imageUrls = preferredImages.map((image: any) => `https:${image.fields.file.url}`);
const primaryImage = imageUrls[0];
const siteUrl = Astro.site?.toString() || 'https://burntdirtart.com';

const printSchema = {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: printTitle,
    image: imageUrls,
    description: printDescription || printTitle,
    brand: {
        '@type': 'Brand',
        name: 'Burnt Dirt Art'
    },
    category: 'Art Print',
    offers: printPrice
        ? {
            '@type': 'Offer',
            price: String(printPrice),
            priceCurrency: 'USD',
            availability: 'https://schema.org/InStock',
            url: new URL(`/shop/prints/${item.fields.inventoryCode}`, siteUrl).toString()
        }
        : undefined,
    creator: {
        '@type': 'Person',
        name: artistName
    },
    url: new URL(`/shop/prints/${item.fields.inventoryCode}`, siteUrl).toString()
};
---

<Layout
    pageTitle={printTitle}
    description={printDescription || `View print details for ${printTitle} from Burnt Dirt Art.`}
    canonicalPath={`/shop/prints/${item.fields.inventoryCode}`}
    image={primaryImage}
    ogType="product"
    pageSchema={printSchema}
>
    <section class="productPage" aria-labelledby="print-title">
        <div class="ds-container">
            <header class="productHeader">
                <p class="ds-eyebrow">Art Print</p>
                <h1 id="print-title">{printTitle}</h1>
            </header>

            <div class="productContent">
                <div class="imageSection">
                    {preferredImages.length > 0 && (
                        <div class="imageCarousel">
                            <div class="imageContainer">
                                {preferredImages.map((image: any, index: number) => (
                                    <img
                                        src={`https:${image.fields.file.url}`}
                                        alt={`${printTitle} - Image ${index + 1}`}
                                        class={`productImage ${index === 0 ? 'active' : ''}`}
                                        data-index={index}
                                        width={image.fields.file.details?.image?.width}
                                        height={image.fields.file.details?.image?.height}
                                        loading={index === 0 ? 'eager' : 'lazy'}
                                        decoding="async"
                                    />
                                ))}
                            </div>
                            {preferredImages.length > 1 && (
                                <div class="carouselDots">
                                    {preferredImages.map((_: any, index: number) => (
                                        <button
                                            class={`dot ${index === 0 ? 'active' : ''}`}
                                            data-index={index}
                                            aria-label={`View image ${index + 1}`}
                                        ></button>
                                    ))}
                                </div>
                            )}
                        </div>
                    )}
                </div>

                <div class="detailsSection">
                    {printPrice && (
                        <p class="price">${printPrice}</p>
                    )}

                    <dl class="detailList">
                        {item.fields.dimensions && (
                            <div class="detailItem">
                                <dt>Dimensions</dt>
                                <dd>{item.fields.dimensions}</dd>
                            </div>
                        )}
                    </dl>

                    {printDescription && (
                        <div class="description">
                            <h2>Description</h2>
                            <p style="white-space: pre-wrap;">{printDescription}</p>
                        </div>
                    )}

                    <div class="actions">
                        <button
                            type="button"
                            class="cartButton addToCartButton"
                            data-cart-id={`print:${item.fields.inventoryCode || printTitle || 'item'}`}
                            data-sku={item.fields.inventoryCode || ''}
                            data-title={printTitle}
                            data-price={String(printPrice ?? '')}
                            data-image={primaryImage || ''}
                            data-detail-url={`/shop/prints/${item.fields.inventoryCode || ''}`}
                            data-type="print"
                            data-single="false"
                        >
                            Add to Cart
                        </button>
                        {hasOriginalAvailable && (
                            <a href={`/shop/${item.fields.inventoryCode}`} class="originalButton">
                                Original Art Available
                            </a>
                        )}
                        <a href="/shop/prints" class="backButton">Back to Prints</a>
                    </div>
                    <p class="cartFeedback" aria-live="polite"></p>
                </div>
            </div>
        </div>
    </section>
</Layout>

<style>
    .productPage {
        background: var(--home-paper);
        padding: clamp(2rem, 4vw, 3.2rem) 0 clamp(2.6rem, 5vw, 4rem);
    }

    .productHeader {
        max-width: 52rem;
        margin: 0 auto clamp(1.2rem, 2.4vw, 1.9rem);
        text-align: center;
    }

    .productHeader h1 {
        margin-bottom: 0;
    }

    .productContent {
        display: grid;
        grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
        gap: clamp(1.4rem, 3.5vw, 2.8rem);
        align-items: start;
    }

    .imageSection {
        position: sticky;
        top: 2rem;
        height: fit-content;
    }

    .imageCarousel {
        position: relative;
    }

    .imageContainer {
        position: relative;
        width: 100%;
        min-height: 290px;
        max-width: 520px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(74, 55, 40, 0.16);
        border-radius: 3px;
        background: #fbf6ea;
        padding: 0.6rem;
        box-shadow: 0 10px 22px rgba(47, 34, 24, 0.12);
        touch-action: pan-y;
    }

    .productImage {
        max-width: 100%;
        max-height: min(62vh, 540px);
        width: auto;
        height: auto;
        object-fit: contain;
        opacity: 0;
        transition: opacity 0.3s ease-in-out;
        border: 1px solid rgba(74, 55, 40, 0.14);
        display: none;
    }

    .productImage.active {
        opacity: 1;
        display: block;
    }

    .carouselDots {
        display: flex;
        justify-content: center;
        gap: 0.5rem;
        margin-top: 1rem;
    }

    .dot {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background-color: #d0d0d0;
        border: none;
        cursor: pointer;
        transition: background-color 0.3s, transform 0.2s;
        padding: 0;
    }

    .dot:hover {
        background-color: #a0a0a0;
        transform: scale(1.2);
    }

    .dot.active {
        background-color: var(--color-terracotta);
    }

    .detailsSection {
        border: 1px solid rgba(74, 55, 40, 0.18);
        border-radius: 4px;
        background: #fdf8ef;
        padding: clamp(1rem, 2vw, 1.45rem);
        box-shadow: 0 8px 18px rgba(47, 34, 24, 0.1);
    }

    .price {
        font-size: clamp(1.6rem, 2.8vw, 2rem);
        font-weight: bold;
        color: var(--color-terracotta);
        margin: 0 0 1rem;
    }

    .detailList {
        margin: 0;
        padding: 0;
    }

    .detailItem {
        margin: 0 0 0.85rem;
        display: grid;
        gap: 0.2rem;
    }

    .detailItem dt {
        font-weight: 700;
        color: var(--color-walnut);
    }

    .detailItem dd {
        margin: 0;
        color: rgba(47, 43, 40, 0.86);
    }

    .description {
        margin: 1.4rem 0 0;
    }

    .description h2 {
        margin-bottom: 0.5rem;
        font-size: 1.05rem;
        color: var(--color-walnut);
    }

    .description p {
        line-height: 1.6;
        margin: 0;
        color: rgba(47, 43, 40, 0.88);
    }

    .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        margin-top: 1.6rem;
    }

    .cartButton,
    .originalButton,
    .backButton {
        display: inline-block;
        padding: 0.75rem 1.5rem;
        text-decoration: none;
        border-radius: 4px;
        font-weight: 700;
        transition: background-color 0.3s, transform 0.2s;
        border: 1px solid transparent;
        cursor: pointer;
        font-size: 0.96rem;
    }

    .cartButton {
        background: var(--color-terracotta);
        color: #fdf6ea;
    }

    .cartButton:hover {
        background: #925239;
        transform: translateY(-1px);
    }

    .cartButton:disabled {
        background: rgba(74, 55, 40, 0.45);
        cursor: not-allowed;
        transform: none;
    }

    .cartFeedback {
        min-height: 1.1rem;
        margin: 0.7rem 0 0;
        color: #7c3f22;
        font-size: 0.9rem;
        font-weight: 700;
        opacity: 0;
        transform: translateY(2px);
        transition: opacity 0.25s ease, transform 0.25s ease;
    }

    .cartFeedback.is-visible {
        opacity: 1;
        transform: translateY(0);
    }

    .originalButton {
        background-color: rgba(74, 55, 40, 0.08);
        color: var(--color-walnut);
        border-color: rgba(74, 55, 40, 0.24);
    }

    .originalButton:hover {
        background-color: rgba(74, 55, 40, 0.14);
    }

    .backButton {
        background-color: #efe5d5;
        color: var(--color-walnut);
        border-color: rgba(74, 55, 40, 0.18);
    }

    .backButton:hover {
        background-color: #e7d8c2;
    }

    @media (max-width: 768px) {
        .productContent {
            grid-template-columns: 1fr;
            gap: 2rem;
        }

        .imageSection {
            position: static;
        }

        .imageContainer {
            min-height: 240px;
            max-width: 100%;
        }

        .actions {
            flex-direction: column;
        }

        .cartButton,
        .originalButton,
        .backButton {
            width: 100%;
            text-align: center;
        }
    }
</style>

<script>
    import { CART_EVENTS, addToCart, readCart } from '../../../scripts/cart';

    document.addEventListener('DOMContentLoaded', () => {
        const imageContainer = document.querySelector('.imageContainer');
        const addToCartButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.addToCartButton'));
        const cartFeedback = document.querySelector<HTMLElement>('.cartFeedback');
        const dots = Array.from(document.querySelectorAll<HTMLButtonElement>('.dot'));
        const images = Array.from(document.querySelectorAll<HTMLImageElement>('.productImage'));
        let feedbackTimeout: number | undefined;

        const showFeedback = (message: string) => {
            if (!cartFeedback) return;
            cartFeedback.textContent = message;
            cartFeedback.classList.add('is-visible');
            if (feedbackTimeout) {
                window.clearTimeout(feedbackTimeout);
            }
            feedbackTimeout = window.setTimeout(() => {
                cartFeedback.classList.remove('is-visible');
            }, 2200);
        };

        const syncSingleItemButtons = () => {
            const cartIds = new Set(readCart().map((item) => item.id));
            addToCartButtons.forEach((button) => {
                const isSingle = button.getAttribute('data-single') === 'true';
                if (!isSingle) return;

                const id = button.getAttribute('data-cart-id') || '';
                const inCart = Boolean(id) && cartIds.has(id);
                button.disabled = inCart;
                button.textContent = inCart ? 'Item in Cart' : 'Add to Cart';
            });
        };

        syncSingleItemButtons();
        window.addEventListener(CART_EVENTS.UPDATED, syncSingleItemButtons);

        addToCartButtons.forEach((button) => {
            button.addEventListener('click', () => {
                const id = button.getAttribute('data-cart-id') || '';
                const sku = button.getAttribute('data-sku') || '';
                const title = button.getAttribute('data-title') || 'Artwork';
                const rawPrice = button.getAttribute('data-price') || '';
                const imageUrl = button.getAttribute('data-image') || '';
                const detailUrl = button.getAttribute('data-detail-url') || '';
                const type = (button.getAttribute('data-type') || 'print') as 'original' | 'print';
                const isSingle = button.getAttribute('data-single') === 'true';

                const price = Number.parseFloat(rawPrice.replace(/[^0-9.]/g, ''));
                addToCart({
                    id: id || `print:${sku || title}`,
                    sku,
                    title,
                    price: Number.isFinite(price) ? price : 0,
                    imageUrl: imageUrl || undefined,
                    detailUrl: detailUrl || undefined,
                    type
                });

                if (isSingle) {
                    syncSingleItemButtons();
                    showFeedback('Added to cart. This piece is now marked as in your cart.');
                    return;
                }

                const previousLabel = button.textContent;
                button.textContent = 'Added to Cart';
                button.disabled = true;
                window.setTimeout(() => {
                    button.textContent = previousLabel;
                    button.disabled = false;
                }, 1200);
                showFeedback('Added to cart.');
            });
        });

        if (images.length === 0) return;

        let activeIndex = Math.max(0, images.findIndex((img) => img.classList.contains('active')));

        const setActiveIndex = (index: number) => {
            const boundedIndex = ((index % images.length) + images.length) % images.length;

            images.forEach((img, imgIndex) => {
                img.classList.toggle('active', imgIndex === boundedIndex);
            });

            dots.forEach((dot, dotIndex) => {
                dot.classList.toggle('active', dotIndex === boundedIndex);
            });

            activeIndex = boundedIndex;
        };

        dots.forEach((dot) => {
            dot.addEventListener('click', () => {
                const index = parseInt(dot.getAttribute('data-index') || '0', 10);
                setActiveIndex(index);
            });
        });

        if (!imageContainer || images.length < 2) return;

        let startX = 0;
        let startY = 0;
        let isTracking = false;
        const minSwipeDistance = 40;
        const maxVerticalDrift = 60;

        imageContainer.addEventListener('touchstart', (event: Event) => {
            const touchEvent = event as TouchEvent;
            if (touchEvent.touches.length !== 1) return;

            const touch = touchEvent.touches[0];
            startX = touch.clientX;
            startY = touch.clientY;
            isTracking = true;
        }, { passive: true });

        imageContainer.addEventListener('touchend', (event: Event) => {
            const touchEvent = event as TouchEvent;
            if (!isTracking || touchEvent.changedTouches.length === 0) return;

            const touch = touchEvent.changedTouches[0];
            const deltaX = touch.clientX - startX;
            const deltaY = touch.clientY - startY;
            isTracking = false;

            if (Math.abs(deltaX) < minSwipeDistance || Math.abs(deltaY) > maxVerticalDrift) {
                return;
            }

            if (deltaX < 0) {
                setActiveIndex(activeIndex + 1);
            } else {
                setActiveIndex(activeIndex - 1);
            }
        }, { passive: true });
    });
</script>
