---
import Layout from '../../layouts/Layout.astro';
import '../../styles/homepage-redesign.css';
import * as contentful from 'contentful';
import { artistName } from '../../config/seo';

export async function getStaticPaths() {
    const normalizeToList = (value: any): string[] => {
        if (!value) return [];

        if (Array.isArray(value)) {
            return value
                .map((entry) => (typeof entry === 'string' ? entry : String(entry ?? '')))
                .map((entry) => entry.trim().toLowerCase())
                .filter(Boolean);
        }

        if (typeof value === 'string') {
            return value
                .split(/[;,]/)
                .map((entry) => entry.trim().toLowerCase())
                .filter(Boolean);
        }

        return [String(value).trim().toLowerCase()].filter(Boolean);
    };

    const isChecked = (value: any): boolean => {
        if (typeof value === 'boolean') return value;
        if (typeof value === 'number') return value === 1;
        if (typeof value === 'string') {
            const normalized = value.trim().toLowerCase();
            return ['true', '1', 'yes', 'y', 'checked'].includes(normalized);
        }
        return false;
    };

    const isShopSelected = (item: any): boolean => {
        if (isChecked(item.fields.shop) || isChecked(item.fields.store)) {
            return true;
        }

        const candidates = [
            item.fields.page,
            item.fields.pages,
            item.fields.pageSection,
            item.fields.pageSections,
            item.fields.sections
        ];

        const values = candidates.flatMap((candidate) => normalizeToList(candidate));
        return values.includes('shop') || values.includes('store');
    };

    const parseSaleState = (item: any): { isSold: boolean; isForSale: boolean } => {
        if (typeof item.fields.forSale === 'boolean') {
            return { isSold: !item.fields.forSale, isForSale: item.fields.forSale };
        }

        if (item.fields.sold === true) {
            return { isSold: true, isForSale: false };
        }

        const saleValue = String(item.fields.sale ?? item.fields.status ?? '').trim().toLowerCase();

        if (saleValue.includes('sold')) {
            return { isSold: true, isForSale: false };
        }

        if (item.fields.forSale === true || item.fields.sale === true || saleValue.includes('for sale') || saleValue === 'sale') {
            return { isSold: false, isForSale: true };
        }

        return { isSold: false, isForSale: false };
    };

  // Get environment variables with fallbacks for Netlify builds
  const space = import.meta.env.CONTENTFUL_SPACE_ID || process.env.CONTENTFUL_SPACE_ID;
  const accessToken = import.meta.env.CONTENTFUL_ACCESS_TOKEN || process.env.CONTENTFUL_ACCESS_TOKEN;
  
  // Check if credentials are available
  if (!space || !accessToken) {
        console.warn(
            'Missing Contentful credentials. Returning no static shop detail pages. ' +
            'Set CONTENTFUL_SPACE_ID and CONTENTFUL_ACCESS_TOKEN in Netlify environment variables.'
        );
        return [];
  }
  
  const client = contentful.createClient({
    space,
    accessToken
  });

  try {
    const entries = await client.getEntries({ 
      content_type: 'artProduct'
    });

    console.log(`Building ${entries.items.length} product pages`);
    
    return entries.items
            .filter((item: any) => {
                if (!item.fields.inventoryCode) return false;
                if (!isShopSelected(item)) return false;
                const { isSold } = parseSaleState(item);
                return !isSold;
            })
      .map((item: any) => {
        console.log(`Creating page for: ${item.fields.inventoryCode} - ${item.fields.title || 'Untitled'}`);
        return {
          params: { slug: item.fields.inventoryCode },
          props: { item }
        };
      });
  } catch (error) {
    console.error('Error fetching products for static paths:', error);
    return [];
  }
}

// Helper function to extract plain text from Contentful rich text
function extractText(richText: any): string {
  if (!richText || !richText.content) return '';
  
  let text = '';
  const traverse = (node: any) => {
    if (node.nodeType === 'text') {
      text += node.value;
    }
    if (node.content && Array.isArray(node.content)) {
      node.content.forEach((child: any) => {
        traverse(child);
        // Add line breaks after paragraphs and headings
        if (['paragraph', 'heading-1', 'heading-2', 'heading-3'].includes(child.nodeType)) {
          text += '\n';
        }
      });
    }
  };
  traverse(richText);
  return text.trim();
}

function normalizeToList(value: any): string[] {
    if (!value) return [];

    if (Array.isArray(value)) {
        return value
            .map((entry) => (typeof entry === 'string' ? entry : String(entry ?? '')))
            .map((entry) => entry.trim().toLowerCase())
            .filter(Boolean);
    }

    if (typeof value === 'string') {
        return value
            .split(/[;,]/)
            .map((entry) => entry.trim().toLowerCase())
            .filter(Boolean);
    }

    return [String(value).trim().toLowerCase()].filter(Boolean);
}

const { item } = Astro.props;
const description = typeof item.fields.description === 'string' 
  ? item.fields.description 
  : extractText(item.fields.description);

const hasPrintAvailable = normalizeToList(item.fields.category).includes('print available') && Boolean(item.fields.inventoryCode);

const imageUrls = item.fields.images?.map((image: any) => `https:${image.fields.file.url}`) || [];
const primaryImage = imageUrls[0];
const siteUrl = Astro.site?.toString() || 'https://burntdirtart.com';

const artworkSchema = {
    '@context': 'https://schema.org',
    '@type': 'VisualArtwork',
    name: item.fields.title || item.fields.inventoryCode,
    image: imageUrls,
    description: description || item.fields.title || item.fields.inventoryCode,
    creator: {
        '@type': 'Person',
        name: artistName
    },
    artMedium: item.fields.category || undefined,
    url: new URL(`/shop/${item.fields.inventoryCode}`, siteUrl).toString()
};
---

<Layout
        pageTitle={item.fields.title || item.fields.inventoryCode}
        description={description || `View details for ${item.fields.title || item.fields.inventoryCode} from Burnt Dirt Art.`}
        canonicalPath={`/shop/${item.fields.inventoryCode}`}
        image={primaryImage}
        ogType="product"
        pageSchema={artworkSchema}
>
    <section class="productPage" aria-labelledby="product-title">
        <div class="ds-container">
            <header class="productHeader">
                <p class="ds-eyebrow">Original Artwork</p>
                <h1 id="product-title">{item.fields.title || item.fields.inventoryCode}</h1>
            </header>

            <div class="productContent">
                <div class="imageSection">
                    {item.fields.images && item.fields.images.length > 0 && (
                        <div class="imageCarousel">
                            <div class="imageContainer">
                                {item.fields.images.map((image: any, index: number) => (
                                    <img 
                                        src={`https:${image.fields.file.url}`}
                                        alt={`${item.fields.title || item.fields.inventoryCode} - Image ${index + 1}`}
                                        class={`productImage ${index === 0 ? 'active' : ''}`}
                                        data-index={index}
                                        width={image.fields.file.details?.image?.width}
                                        height={image.fields.file.details?.image?.height}
                                        loading={index === 0 ? 'eager' : 'lazy'}
                                        decoding="async"
                                    />
                                ))}
                            </div>
                            {item.fields.images.length > 1 && (
                                <div class="carouselDots">
                                    {item.fields.images.map((_: any, index: number) => (
                                        <button 
                                            class={`dot ${index === 0 ? 'active' : ''}`}
                                            data-index={index}
                                            aria-label={`View image ${index + 1}`}
                                        ></button>
                                    ))}
                                </div>
                            )}
                        </div>
                    )}
                </div>

                <div class="detailsSection">
                    {item.fields.price && (
                        <p class="price">${item.fields.price}</p>
                    )}

                    <dl class="detailList">
                        {item.fields.dimensions && (
                            <div class="detailItem">
                                <dt>Dimensions</dt>
                                <dd>{item.fields.dimensions}</dd>
                            </div>
                        )}
                        {item.fields.dateCompleted && (
                            <div class="detailItem">
                                <dt>Completed</dt>
                                <dd>{new Date(item.fields.dateCompleted).toLocaleDateString()}</dd>
                            </div>
                        )}
                    </dl>

                    {description && (
                        <div class="description">
                            <h2>Description</h2>
                            <p style="white-space: pre-wrap;">{description}</p>
                        </div>
                    )}

                    <div class="actions">
                        <button
                            type="button"
                            class="cartButton addToCartButton"
                            data-cart-id={`original:${item.fields.inventoryCode || item.fields.title || 'item'}`}
                            data-sku={item.fields.inventoryCode || ''}
                            data-title={item.fields.title || item.fields.inventoryCode || 'Artwork'}
                            data-price={String(item.fields.price ?? '')}
                            data-image={primaryImage || ''}
                            data-detail-url={`/shop/${item.fields.inventoryCode || ''}`}
                            data-type="original"
                            data-single="true"
                        >
                            Add to Cart
                        </button>
                        {hasPrintAvailable && (
                            <a href={`/shop/prints/${item.fields.inventoryCode}`} class="printButton">
                                Print Available
                            </a>
                        )}
                        <a href="/shop" class="backButton">Back to Shop</a>
                    </div>
                    <p class="cartFeedback" aria-live="polite"></p>
                </div>
            </div>
        </div>
    </section>
</Layout>

<style>
    .productPage {
        background: var(--home-paper);
        padding: clamp(2rem, 4vw, 3.2rem) 0 clamp(2.6rem, 5vw, 4rem);
    }

    .productHeader {
        max-width: 52rem;
        margin: 0 auto clamp(1.2rem, 2.4vw, 1.9rem);
        text-align: center;
    }

    .productHeader h1 {
        margin-bottom: 0;
    }

    .productContent {
        display: grid;
        grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
        gap: clamp(1.4rem, 3.5vw, 2.8rem);
        align-items: start;
    }

    .imageSection {
        position: sticky;
        top: 2rem;
        height: fit-content;
    }

    .imageCarousel {
        position: relative;
    }

    .imageContainer {
        position: relative;
        width: 100%;
        min-height: 290px;
        max-width: 520px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(74, 55, 40, 0.16);
        border-radius: 3px;
        background: #fbf6ea;
        padding: 0.6rem;
        box-shadow: 0 10px 22px rgba(47, 34, 24, 0.12);
        touch-action: pan-y;
    }

    .productImage {
        max-width: 100%;
        max-height: min(62vh, 540px);
        width: auto;
        height: auto;
        object-fit: contain;
        opacity: 0;
        transition: opacity 0.3s ease-in-out;
        border: 1px solid rgba(74, 55, 40, 0.14);
        display: none;
    }

    .productImage.active {
        opacity: 1;
        display: block;
    }

    .carouselDots {
        display: flex;
        justify-content: center;
        gap: 0.5rem;
        margin-top: 1rem;
    }

    .dot {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background-color: #d0d0d0;
        border: none;
        cursor: pointer;
        transition: background-color 0.3s, transform 0.2s;
        padding: 0;
    }

    .dot:hover {
        background-color: #a0a0a0;
        transform: scale(1.2);
    }

    .dot.active {
        background-color: var(--color-terracotta);
    }

    .detailsSection {
        border: 1px solid rgba(74, 55, 40, 0.18);
        border-radius: 4px;
        background: #fdf8ef;
        padding: clamp(1rem, 2vw, 1.45rem);
        box-shadow: 0 8px 18px rgba(47, 34, 24, 0.1);
    }

    .price {
        font-size: clamp(1.6rem, 2.8vw, 2rem);
        font-weight: bold;
        color: var(--color-terracotta);
        margin: 0 0 1rem;
    }

    .detailList {
        margin: 0;
        padding: 0;
    }

    .detailItem {
        margin: 0 0 0.85rem;
        display: grid;
        gap: 0.2rem;
    }

    .detailItem dt {
        font-weight: 700;
        color: var(--color-walnut);
    }

    .detailItem dd {
        margin: 0;
        color: rgba(47, 43, 40, 0.86);
    }

    .description {
        margin: 1.4rem 0 0;
    }

    .description h2 {
        margin-bottom: 0.5rem;
        font-size: 1.05rem;
        color: var(--color-walnut);
    }

    .description p {
        line-height: 1.6;
        margin: 0;
        color: rgba(47, 43, 40, 0.88);
    }

    .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        margin-top: 1.6rem;
    }

    .cartButton,
    .printButton,
    .backButton {
        display: inline-block;
        padding: 0.75rem 1.5rem;
        text-decoration: none;
        border-radius: 4px;
        font-weight: 700;
        transition: background-color 0.3s, transform 0.2s;
        border: 1px solid transparent;
        cursor: pointer;
        font-size: 0.96rem;
    }

    .cartButton {
        background: var(--color-terracotta);
        color: #fdf6ea;
    }

    .cartButton:hover {
        background: #925239;
        transform: translateY(-1px);
    }

    .cartButton:disabled {
        background: rgba(74, 55, 40, 0.45);
        cursor: not-allowed;
        transform: none;
    }

    .cartFeedback {
        min-height: 1.1rem;
        margin: 0.7rem 0 0;
        color: #7c3f22;
        font-size: 0.9rem;
        font-weight: 700;
        opacity: 0;
        transform: translateY(2px);
        transition: opacity 0.25s ease, transform 0.25s ease;
    }

    .cartFeedback.is-visible {
        opacity: 1;
        transform: translateY(0);
    }

    .printButton {
        background-color: rgba(168, 95, 62, 0.12);
        color: #7c3f22;
        border-color: rgba(168, 95, 62, 0.35);
    }

    .printButton:hover {
        background-color: rgba(168, 95, 62, 0.2);
    }

    .backButton {
        background-color: rgba(74, 55, 40, 0.08);
        color: var(--color-walnut);
        border-color: rgba(74, 55, 40, 0.24);
    }

    .backButton:hover {
        background-color: rgba(74, 55, 40, 0.14);
    }

    @media (max-width: 768px) {
        .productContent {
            grid-template-columns: 1fr;
            gap: 2rem;
        }

        .imageSection {
            position: static;
        }

        .imageContainer {
            min-height: 240px;
            max-width: 100%;
        }

        .actions {
            flex-direction: column;
        }

        .cartButton,
        .printButton,
        .backButton {
            width: 100%;
            text-align: center;
        }
    }
</style>

<script>
    import { CART_EVENTS, addToCart, readCart } from '../../scripts/cart';

    document.addEventListener('DOMContentLoaded', () => {
        const imageContainer = document.querySelector('.imageContainer');
        const addToCartButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.addToCartButton'));
        const cartFeedback = document.querySelector<HTMLElement>('.cartFeedback');
        const dots = Array.from(document.querySelectorAll<HTMLButtonElement>('.dot'));
        const images = Array.from(document.querySelectorAll<HTMLImageElement>('.productImage'));
        let feedbackTimeout: number | undefined;

        const showFeedback = (message: string) => {
            if (!cartFeedback) return;
            cartFeedback.textContent = message;
            cartFeedback.classList.add('is-visible');
            if (feedbackTimeout) {
                window.clearTimeout(feedbackTimeout);
            }
            feedbackTimeout = window.setTimeout(() => {
                cartFeedback.classList.remove('is-visible');
            }, 2200);
        };

        const syncSingleItemButtons = () => {
            const cartIds = new Set(readCart().map((item) => item.id));
            addToCartButtons.forEach((button) => {
                const isSingle = button.getAttribute('data-single') === 'true';
                if (!isSingle) return;

                const id = button.getAttribute('data-cart-id') || '';
                const inCart = Boolean(id) && cartIds.has(id);
                button.disabled = inCart;
                button.textContent = inCart ? 'Item in Cart' : 'Add to Cart';
            });
        };

        syncSingleItemButtons();
        window.addEventListener(CART_EVENTS.UPDATED, syncSingleItemButtons);

        addToCartButtons.forEach((button) => {
            button.addEventListener('click', () => {
                const id = button.getAttribute('data-cart-id') || '';
                const sku = button.getAttribute('data-sku') || '';
                const title = button.getAttribute('data-title') || 'Artwork';
                const rawPrice = button.getAttribute('data-price') || '';
                const imageUrl = button.getAttribute('data-image') || '';
                const detailUrl = button.getAttribute('data-detail-url') || '';
                const type = (button.getAttribute('data-type') || 'original') as 'original' | 'print';
                const isSingle = button.getAttribute('data-single') === 'true';

                const price = Number.parseFloat(rawPrice.replace(/[^0-9.]/g, ''));
                addToCart({
                    id: id || `original:${sku || title}`,
                    sku,
                    title,
                    price: Number.isFinite(price) ? price : 0,
                    imageUrl: imageUrl || undefined,
                    detailUrl: detailUrl || undefined,
                    type
                });

                if (isSingle) {
                    syncSingleItemButtons();
                    showFeedback('Added to cart. This piece is now marked as in your cart.');
                    return;
                }

                const previousLabel = button.textContent;
                button.textContent = 'Added to Cart';
                button.disabled = true;
                window.setTimeout(() => {
                    button.textContent = previousLabel;
                    button.disabled = false;
                }, 1200);
                showFeedback('Added to cart.');
            });
        });

        if (images.length === 0) return;

        let activeIndex = Math.max(0, images.findIndex((img) => img.classList.contains('active')));

        const setActiveIndex = (index: number) => {
            const boundedIndex = ((index % images.length) + images.length) % images.length;

            images.forEach((img, imgIndex) => {
                img.classList.toggle('active', imgIndex === boundedIndex);
            });

            dots.forEach((dot, dotIndex) => {
                dot.classList.toggle('active', dotIndex === boundedIndex);
            });

            activeIndex = boundedIndex;
        };

        dots.forEach((dot) => {
            dot.addEventListener('click', () => {
                const index = parseInt(dot.getAttribute('data-index') || '0', 10);
                setActiveIndex(index);
            });
        });

        if (!imageContainer || images.length < 2) return;

        let startX = 0;
        let startY = 0;
        let isTracking = false;
        const minSwipeDistance = 40;
        const maxVerticalDrift = 60;

        imageContainer.addEventListener('touchstart', (event: Event) => {
            const touchEvent = event as TouchEvent;
            if (touchEvent.touches.length !== 1) return;

            const touch = touchEvent.touches[0];
            startX = touch.clientX;
            startY = touch.clientY;
            isTracking = true;
        }, { passive: true });

        imageContainer.addEventListener('touchend', (event: Event) => {
            const touchEvent = event as TouchEvent;
            if (!isTracking || touchEvent.changedTouches.length === 0) return;

            const touch = touchEvent.changedTouches[0];
            const deltaX = touch.clientX - startX;
            const deltaY = touch.clientY - startY;
            isTracking = false;

            if (Math.abs(deltaX) < minSwipeDistance || Math.abs(deltaY) > maxVerticalDrift) {
                return;
            }

            if (deltaX < 0) {
                setActiveIndex(activeIndex + 1);
            } else {
                setActiveIndex(activeIndex - 1);
            }
        }, { passive: true });
    });
</script>
